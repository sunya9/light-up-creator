{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "default-case": "error"
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "excludeFiles": ["src/components/ui/**/*.tsx"],
      "rules": {
        "react/only-export-components": ["error"]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
